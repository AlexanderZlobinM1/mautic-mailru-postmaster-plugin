<div class="table-responsive">
    {% set showTrend = showTrend is defined ? showTrend : true %}
    <table class="table table-hover">
        <thead>
        <tr>
            {% if showDomain %}<th>{{ 'mailru.postmaster.report.domain'|trans }}</th>{% endif %}
            <th>{{ 'mailru.postmaster.report.date'|trans }}</th>
            <th class="text-right">{{ 'mailru.postmaster.report.messages_sent'|trans }}</th>
            <th class="text-right">{{ 'mailru.postmaster.report.complaints'|trans }}</th>
            <th class="text-right">{{ 'mailru.postmaster.report.reputation'|trans }}</th>
            {% if showTrend %}<th class="text-right">{{ 'mailru.postmaster.report.trend'|trans }}</th>{% endif %}
            <th>{{ 'mailru.postmaster.report.deliverability'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            {% set hasStatistics = row.has_statistics is defined ? row.has_statistics : true %}
            {% set spam = row.spam_percent + 0 %}
            {% set probablySpam = row.probably_spam_percent + 0 %}
            {% set delivered = hasStatistics ? 100 - spam - probablySpam : 0 %}
            {% if delivered < 0 %}{% set delivered = 0 %}{% endif %}
            <tr>
                {% if showDomain %}
                    <td>
                        <a href="{{ path('mautic_mailru_postmaster_domain', {domain: row.domain}) }}" data-toggle="ajax">
                            {{ row.domain }}
                        </a>
                    </td>
                {% endif %}
                <td>{{ row.stat_date|date('d.m.Y') }}</td>
                <td class="text-right">{{ row.messages_sent|number_format(0, ',', ' ') }}</td>
                <td class="text-right">{{ row.complaints|number_format(0, ',', ' ') }}</td>
                <td class="text-right">{{ row.reputation|number_format(2, ',', ' ') }}</td>
                {% if showTrend %}
                    <td class="text-right">
                        {{ row.trend|number_format(2, ',', ' ') }}
                        {% if row.trend > 0 %}<i class="ri-arrow-up-line text-danger"></i>{% elseif row.trend < 0 %}<i class="ri-arrow-down-line text-success"></i>{% endif %}
                    </td>
                {% endif %}
                <td style="min-width: 260px">
                    <div class="d-flex" style="height: 28px; overflow: hidden; border-radius: 2px">
                        {% if not hasStatistics %}
                            <div class="pa-xs text-secondary">0,0</div>
                        {% else %}
                            {% if delivered > 0 %}<div class="bg-success pa-xs" style="width: {{ delivered }}%" title="{{ delivered|number_format(2, ',', ' ') }}%">{{ delivered|number_format(1, ',', ' ') }}</div>{% endif %}
                            {% if probablySpam > 0 %}<div class="bg-warning pa-xs" style="width: {{ probablySpam }}%" title="{{ 'mailru.postmaster.report.probably_spam'|trans }}: {{ probablySpam|number_format(2, ',', ' ') }}%">{{ probablySpam|number_format(1, ',', ' ') }}</div>{% endif %}
                            {% if spam > 0 %}<div class="bg-danger pa-xs" style="width: {{ spam }}%" title="{{ 'mailru.postmaster.report.spam'|trans }}: {{ spam|number_format(2, ',', ' ') }}%">{{ spam|number_format(1, ',', ' ') }}</div>{% endif %}
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
