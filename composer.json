{
  "name": "alexanderzlobin/mautic-mailru-postmaster-bundle",
  "description": "Mail.ru Postmaster statistics, reports and campaign guard for Mautic.",
  "type": "mautic-plugin",
  "license": "proprietary",
  "keywords": [
    "mautic",
    "mail.ru",
    "postmaster",
    "deliverability",
    "spam"
  ],
  "require": {
    "php": ">=8.2",
    "mautic/core-lib": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "MauticPlugin\\MauticMailRuPostmasterBundle\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MauticPlugin\\MauticMailRuPostmasterBundle\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "install-directory-name": "MauticMailRuPostmasterBundle"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
